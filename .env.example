# Usuario/contraseña que exige toda la web (no hay sistema de cuentas todavía).
# Obligatorio: sin esto la app rechaza todas las peticiones (ver proxy.ts).
APP_USERNAME=...
APP_PASSWORD=...

# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo a usar para la extracción (por defecto claude-sonnet-5).
# ANTHROPIC_MODEL=claude-sonnet-5

# Credenciales OAuth de Google Cloud Console (Gmail API), solo necesarias para el
# agente de correo (/correo). Ver "Agente de correo (opcional)" en el README para
# los pasos de configuración.
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
