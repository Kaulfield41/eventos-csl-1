# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo a usar para la extracción (por defecto claude-sonnet-5).
# ANTHROPIC_MODEL=claude-sonnet-5

# Credenciales OAuth de Google Cloud Console (Gmail API), solo necesarias para el
# agente de correo (/correo). Ver "Configuración en Google Cloud Console" en
# /Users/csl/.claude/plans/valiant-launching-wirth.md para los pasos exactos.
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
